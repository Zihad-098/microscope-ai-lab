print ("====== Microscope AI Lab ======")

fungi_images = int (input("Enter fungal image count: "))
bacteria_images = int (input ("Enter bacterial image count: "))
damaged_images = int (input("Enter damaged image count: "))

valid_images = fungi_images + bacteria_images
total_images = valid_images + damaged_images

print ("\n=== Dataset Summary ===")
print ("Fungal iamges:",fungi_images)
print ("Bacterial images:",bacteria_images)
print ("Damaged images:",damaged_images)
print ("Valid images:",valid_images)
print ("Total images:",total_images)

percentage = (fungi_images / valid_images) * 100
print ("Fungal image percentage",percentage,"%")
if valid_images > 0:
    percentage = (fungi_images/valid_images)*100
    print ("Fingal image percentage:",round(percentage,2),"%")
else:
    print ("Cannot calculate percentage : no valid images.")
if valid_images > 0:
    percentage = (bacteria_images / total_images)*100
    print ("Bacteria image percentage:",round(percentage,2),"%")
else :
    print ("Cannot calculate percentage : no valid images.")
